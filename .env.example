# Qwen Gateway + local avatar control service. Both bind localhost by default.
QWEN_GATEWAY_HOST=127.0.0.1
QWEN_GATEWAY_PORT=8765
AVATAR_CONTROL_HOST=127.0.0.1
AVATAR_CONTROL_PORT=8788
SALES_AVATAR_MAX_SESSIONS=8

# Multi-buyer Qwen identity. Browser mode gives each headless sales-avatar
# session a different Qwen owner, allowing concurrent website buyers.
QWEN_AUDIO_AGENT_IDENTITY_MODE=browser
# Optional persistent signing secret (32+ chars). If blank, our launcher creates
# a process-local random secret. Set a persistent secret before multi-instance
# production so signed identities survive process/pod changes.
QWEN_AUDIO_AGENT_AUTH_SECRET=

# Realtime voice frontend.
QWEN_AUDIO_REALTIME_PROVIDER=gpt-live
OPENAI_API_KEY=
# Use our consultative sales persona. Routing itself is enforced by the
# Gateway's sales-specific spawn_thinking capability description.
QWEN_AUDIO_AGENT_ASSISTANT_PROFILE_PATH=./config/sales-assistant.md
# Optional: let the pinned Qwen runtime use its provider defaults unless you
# intentionally want to override the realtime model/voice.
GPT_LIVE_REALTIME_MODEL=
GPT_LIVE_REALTIME_VOICE=

# Hidden sales supervisor. Start live transport testing with `mock` to isolate
# voice/avatar integration. Switch to `openai-compatible` for DeepSeek, GLM,
# Qwen, or another compatible endpoint after transport is proven.
SALES_REASONER_MODE=mock
SALES_REASONER_BASE_URL=
SALES_REASONER_API_KEY=
SALES_REASONER_MODEL=
SALES_REASONER_TIMEOUT_MS=12000

# Server-owned ROI calculator. These are explicit illustrative assumptions,
# never model-generated numbers. Replace them with company-approved assumptions
# before using ROI with real prospects.
SALES_ROI_CURRENCY=USD
SALES_ROI_HOURLY_COST=75
SALES_ROI_HOURS_SAVED_PER_REP_MONTH=2
SALES_ROI_ADOPTION_RATE=0.6
SALES_ROI_ASSUMPTION_SET=illustrative-default-v1

# Case studies are intentionally empty by default. Only load approved evidence
# into CaseStudyCatalog; the supervisor cannot invent customer proof.

# HeyGen LiveAvatar LITE. The bridge consumes ws_url directly server-side.
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=

# Paid smoke test. This is only used by `npm run smoke:live`.
LIVE_SMOKE_PROMPT=We have 45 sales reps and need Salesforce and SSO. Which plan fits us and why?
LIVE_SMOKE_LISTEN_MS=12000
