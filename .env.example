# Public control server. Render supplies PORT automatically.
AVATAR_CONTROL_HOST=127.0.0.1
AVATAR_CONTROL_PORT=8788
SALES_AVATAR_MAX_SESSIONS=8

# PRE-HEYGEN TEST: native OpenAI GPT-Live WebRTC + DeepSeek sales brain.
# These are the only two secrets required for this mode.
SALES_VOICE_MODE=native-gpt-live
OPENAI_API_KEY=
SALES_REASONER_API_KEY=

# Native GPT-Live defaults.
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=marin
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek defaults. SALES_REASONER_API_KEY is the DeepSeek API key above.
SALES_REASONER_MODE=deepseek
SALES_REASONER_BASE_URL=https://api.deepseek.com
SALES_REASONER_MODEL=deepseek-flash
SALES_REASONER_TIMEOUT_MS=12000
SALES_BUSINESS_CONTEXT=

# External-action execution. Keep disabled for live sales testing until explicit
# connectors and confirmations are configured. `sandbox` uses fake providers only.
SALES_ACTION_EXECUTION_MODE=disabled

# Product/service truth. For a real pilot use ONE explicit JSON source.
SALES_PRODUCTS_PATH=
SALES_PRODUCTS_JSON=

# Server-owned ROI calculator. Replace illustrative assumptions before production use.
SALES_ROI_CURRENCY=USD
SALES_ROI_HOURLY_COST=75
SALES_ROI_HOURS_SAVED_PER_REP_MONTH=2
SALES_ROI_ADOPTION_RATE=0.6
SALES_ROI_ASSUMPTION_SET=illustrative-default-v1

# Approved customer proof. Leave blank to expose zero named case studies.
SALES_CASE_STUDIES_PATH=
SALES_CASE_STUDIES_JSON=

# FUTURE HEYGEN/QWEN MODE. Not required for the native GPT-Live test above.
QWEN_GATEWAY_HOST=127.0.0.1
QWEN_GATEWAY_PORT=8765
QWEN_AUDIO_AGENT_IDENTITY_MODE=browser
QWEN_AUDIO_AGENT_AUTH_SECRET=
QWEN_AUDIO_REALTIME_PROVIDER=gpt-live
QWEN_AUDIO_AGENT_ASSISTANT_PROFILE_PATH=./config/sales-assistant.md
GPT_LIVE_REALTIME_MODEL=
GPT_LIVE_REALTIME_VOICE=
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=

# Paid legacy smoke test.
LIVE_SMOKE_PROMPT=We have 45 sales reps and need Salesforce and SSO. Which plan fits us and why?
LIVE_SMOKE_LISTEN_MS=12000
